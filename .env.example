# Docker Compose development settings.
# Copy this file to .env and set a local password before starting Docker.
POSTGRES_DB=jari_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5433

# Ollama remains on the host machine by default.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# LLM provider utama: gemini (Google AI Studio) | backup cascade: ollama lokal.
# Tanpa GEMINI_API_KEY (atau tanpa internet) cascade otomatis pakai Ollama; jika kedua
# LLM gagal, narasi jatuh ke template deterministik. LLM tidak pernah mengubah skor.
# Saat memproses data peserta JKN riil: set LLM_PROVIDER=ollama.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Per-agent local backup models (dipakai OllamaClient saat cascade ke lokal).
DEFAULT_MODEL=mistral:7b
CLINICAL_MODEL=mistral:7b
REVIEW_MODEL=deepseek-r1:7b
REVIEW_MODEL_FALLBACK=mistral:7b
EXPLANATION_MODEL=qwen2.5:7b
EXPLANATION_MODEL_FALLBACK=mistral:7b

# Optional: HuggingFace token for higher model-download rate limits.
# Keep the real token only in local .env; never commit it.
HF_TOKEN=
