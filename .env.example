# Konfigurasi lokal Windows AEGIS-Health.
# Salin berkas ini ke .env lalu sesuaikan. Jangan commit .env (sudah gitignored).

# PostgreSQL lokal (wajib). Buat database aegis_health_db terlebih dahulu (lihat README).
DATABASE_URL=postgresql+asyncpg://postgres:<password-lokal>@localhost:5432/aegis_health_db

# LLM narasi. Kebijakan arsitektur (docs/DECISIONS.md, 2026-10-27): local-first.
# Rantai produksi resmi: Ollama lokal (deepseek-r1:7b, LLM Pelapor) -> gemini -> template.
# Sementara nilai di bawah masih gemini agar setup pengembang ringan; default rantai
# pindah ke ollama saat integrasi post-1-Nov. Untuk berjalan lokal penuh SEKARANG:
# set LLM_PROVIDER=ollama (model per slot: blok Ollama di bawah).
# - PRIVASI: data peserta JKN riil WAJIB LLM_PROVIDER=ollama (data kesehatan tidak
#   keluar mesin; selaras UU PDP No. 27/2022 dan kebijakan DECISIONS.md).
# - COST/KEBERLANJUTAN: LLM hanya menyusun narasi; skor/tier/bukti tetap deterministik
#   dari pipeline. Tanpa kunci/internet, cascade turun ke Ollama lalu template
#   deterministik (biaya marginal Rp0 per klaim).
# - AUDIT: model disematkan + seed 42 + temperature 0.2; benchmark ulang wajib
#   (scripts/agent/llm_bench.py, 3 envelope x 2 mode x 6 panggilan) setiap
#   ganti model/provider. LLM tidak pernah mengubah skor/tier/bukti.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama lokal (backup narasi sekarang; PRIMARY produksi post-1-Nov - deepseek-r1:7b
# sebagai LLM Pelapor; self-hosted open-weight MIT, data tidak keluar mesin).
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=mistral:7b
CLINICAL_MODEL=mistral:7b
REVIEW_MODEL=deepseek-r1:7b
REVIEW_MODEL_FALLBACK=mistral:7b
EXPLANATION_MODEL=qwen2.5:7b
EXPLANATION_MODEL_FALLBACK=mistral:7b

# Opsional: token HuggingFace untuk batas unduhan model lebih tinggi.
# Simpan token asli hanya di .env lokal; jangan pernah di-commit.
HF_TOKEN=
